# Copy this file to `.env` in the project root and fill in your values.
# Never commit `.env` — it is gitignored.

# --- Indian Stock Market API (required for OHLCV + ML training) ---
# Subscribe (free tier works) at https://indianapi.in/indian-stock-market
# Dashboard → API / Manage Keys → copy your API key
INDIAN_API_KEY=

# Optional: only if your plan uses a different base URL
# Free/Hobby: https://stock.indianapi.in
# Developer: https://dev.indianapi.in
# Growth Analyst: https://analyst.indianapi.in
# Pro: https://pro.indianapi.in
# INDIAN_API_BASE_URL=https://stock.indianapi.in

# --- Telegram alerts (optional but recommended) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
