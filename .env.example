# Copy this file to `.env` in the project root and fill in your values.
# Never commit `.env` — it is gitignored.

# --- Dhan API (required for OHLCV + ML training) ---
# Get these from https://web.dhan.co → Profile → "DhanHQ Trading APIs"
# 1. Client ID — shown on the API page
# 2. Access Token — generate via "Generate Access Token" (valid ~24h; renew daily or use static token if enabled)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# --- Telegram alerts (optional but recommended) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
